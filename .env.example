# Copy this file to ".env" and edit. NEVER commit ".env".
# All values below are placeholders/defaults, not real secrets.

# Where Ollama runs (keep it on this machine / a private network)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# --- CLOUD MODE (optional, for hosting while your laptop is off) ---
# Uses Ollama's hosted service instead of a local Ollama. Your text is then sent to ollama.com.
# Create your own key at ollama.com/settings/keys and paste it ONLY into your host's
# environment settings or your local .env. Never paste it in a chat or commit it.
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=
# OLLAMA_MODEL=<a model name listed for your account, not llama3.2:1b>

# Where this web app listens. 127.0.0.1 = only this computer.
# A non-loopback HOST (e.g. 0.0.0.0) is REFUSED unless COMPACTION_ACCESS_TOKEN is set.
HOST=127.0.0.1
PORT=5000

# Optional access token (min 16 chars). Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# COMPACTION_ACCESS_TOKEN=

# Limits
MAX_INPUT_CHARS=100000
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT=1
OLLAMA_READ_TIMEOUT=180

# Optional: comma-separated exact origins allowed for CORS (only if frontend is hosted elsewhere)
# CORS_ORIGINS=https://your-frontend.example
